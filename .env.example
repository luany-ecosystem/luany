APP_NAME=Luany
# development | production — production disables debug pages and live reload.
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=en
LUANY_SYNTAX=en
LUANY_DEV_LANGUAGE=en

# sqlite (no server needed) | mysql | pgsql
DB_CONNECTION=sqlite
DB_NAME=database/database.sqlite
# For mysql / pgsql:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=luany
# DB_USER=root
# DB_PASS=

MAIL_MAILER=log
MAIL_FROM_ADDRESS=hello@example.com
MAIL_FROM_NAME="${APP_NAME}"
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
