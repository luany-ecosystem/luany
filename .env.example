APP_NAME=Luany
# development | production — production disables debug pages and live reload.
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_KEY=
APP_TIMEZONE=UTC
APP_LOCALE=en

# sqlite (no server needed) | mysql | pgsql
DB_CONNECTION=sqlite
DB_NAME=database/database.sqlite
# For mysql / pgsql:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=luany
# DB_USER=root
# DB_PASS=
