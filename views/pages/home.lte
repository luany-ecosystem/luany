@style
.welcome {
    position: relative; isolation: isolate; overflow: hidden;
    min-height: 100vh; display: flex; flex-direction: column;
    background: var(--brand-ink); color: rgba(255, 255, 255, .86);
}
.welcome::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(ellipse at 15% 45%, rgba(5, 6, 26, .9), transparent 60%);
}
.welcome canvas { position: absolute; inset: 0; width: 100%; height: 100%; z-index: -2; }
.welcome h1, .welcome h2 { color: #fff; }

.welcome-top { display: flex; align-items: center; gap: .75rem; padding-block: 1.6rem; }
.welcome-top img { width: 36px; height: 36px; }
.welcome-top strong { font: 800 1.1rem var(--font-display); color: #fff; }
.welcome-top .chip {
    margin-left: auto; padding: .35rem .8rem; border-radius: 999px;
    border: 1px solid rgba(255, 255, 255, .16); font: 500 .78rem var(--font-mono); color: rgba(255, 255, 255, .7);
}

.welcome-body { flex: 1; display: flex; flex-direction: column; justify-content: center; padding-block: 3rem 4rem; }
.welcome h1 { font-size: clamp(2.8rem, 1.6rem + 5vw, 5.6rem); letter-spacing: -.05em; line-height: .98; margin-bottom: 1.5rem; }
.welcome h1 .accent { background: var(--gradient-text); -webkit-background-clip: text; background-clip: text; color: transparent; }
.welcome .lead { max-width: 36ch; font-size: clamp(1.05rem, 1rem + .4vw, 1.3rem); color: rgba(255, 255, 255, .72); margin-bottom: 2.5rem; }
.welcome .lead code { background: rgba(255, 255, 255, .08); color: #FDB37A; }

.welcome-steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; margin-bottom: 2.5rem; }
.welcome-step {
    display: flex; flex-direction: column; gap: .6rem; padding: 1.4rem;
    border-radius: var(--radius); border: 1px solid rgba(255, 255, 255, .1);
    background: rgba(255, 255, 255, .04); backdrop-filter: blur(6px); color: inherit;
    transition: border-color .25s var(--ease), transform .25s var(--ease), background .25s var(--ease);
}
.welcome-step:hover { text-decoration: none; border-color: rgba(253, 150, 47, .5); background: rgba(255, 255, 255, .06); transform: translateY(-3px); }
.welcome-step span { font: 500 .78rem var(--font-mono); color: var(--brand-orange); }
.welcome-step h2 { font-size: 1.2rem; }
.welcome-step p { font-size: .95rem; color: rgba(255, 255, 255, .66); }
.welcome-step > code { margin-top: auto; display: block; padding: .55rem .7rem; border-radius: 8px; background: rgba(5, 6, 26, .6); color: #E4DFEC; font-size: .8rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.welcome-actions { display: flex; flex-wrap: wrap; gap: .75rem; }
.welcome .btn-secondary { background: rgba(255, 255, 255, .04); color: #fff; border-color: rgba(255, 255, 255, .28); }
.welcome .btn-secondary:hover { border-color: #fff; }

.welcome-foot {
    display: flex; flex-wrap: wrap; gap: .5rem 1.5rem; padding-block: 1.4rem;
    border-top: 1px solid rgba(255, 255, 255, .08); font: .8rem var(--font-mono); color: rgba(255, 255, 255, .5);
}
.welcome-foot b { color: rgba(255, 255, 255, .8); font-weight: 500; }

@media (max-width: 860px) { .welcome-steps { grid-template-columns: 1fr; } }
@endstyle

