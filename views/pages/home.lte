@script
// Brand waves: thin lines in the colours of the Luany crescent. One static frame with reduced motion.
(function () {
    var canvas = document.querySelector('[data-welcome-wave]');
    if (!canvas || !canvas.getContext) return;
    var ctx = canvas.getContext('2d'), w = 0, h = 0, still = matchMedia('(prefers-reduced-motion: reduce)').matches;
    function resize() {
        var dpr = Math.min(devicePixelRatio || 1, 2), r = canvas.getBoundingClientRect();
        w = r.width; h = r.height; canvas.width = w * dpr; canvas.height = h * dpr; ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    }
    function draw(t) {
        ctx.clearRect(0, 0, w, h);
        var g = ctx.createLinearGradient(0, h, w, 0);
        g.addColorStop(0, '#7A45A3'); g.addColorStop(.5, '#E4613E'); g.addColorStop(1, '#FD962F');
        ctx.strokeStyle = g; ctx.lineWidth = 1; ctx.globalCompositeOperation = 'lighter';
        for (var i = 0; i < 60; i++) {
            var p = i / 60;
            ctx.globalAlpha = .45 * (.25 + .75 * Math.sin(p * Math.PI));
            ctx.beginPath();
            for (var x = -8; x <= w + 8; x += 8) {
                var y = h * (.98 - .74 * Math.pow(x / w, .9)) + Math.sin(x * .0032 + t * .00022 + p * 2.4) * 46 * (.6 + p) + (p - .5) * 90;
                x === -8 ? ctx.moveTo(x, y) : ctx.lineTo(x, y);
            }
            ctx.stroke();
        }
        ctx.globalAlpha = 1;
        if (!still) requestAnimationFrame(draw);
    }
    resize(); addEventListener('resize', resize);
    draw(1200);
}());
@endscript
